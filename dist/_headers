# Cloudflare Pages / Netlify Cache-Control Headers

# Never cache index.html, service worker, or manifest so updates are immediate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

# Immutable cache for Vite fingerprinted assets (contains hash in filename)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

